# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Required — get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Data storage paths (created automatically on first run)
# Change these to suit your OS / drive layout
DATA_PATH=D:\JobDeck\data
LOG_PATH=D:\JobDeck\logs
BACKUP_PATH=D:\JobDeck\backups

# Server
PORT=3001
NODE_ENV=development

# Optional
LOW_DISK_WARNING_GB=2
ACCENT_COLOR=#423A8E
