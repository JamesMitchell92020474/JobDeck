# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.
# On first run, JobDeck's setup wizard will generate this file for you.

# Required — get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Data storage paths (created automatically on first run)
# Defaults to C:\Users\<you>\JobDeck\... if not set
DATA_PATH=
LOG_PATH=
BACKUP_PATH=

# Your display name and location (set by the setup wizard, editable in Settings)
DISPLAY_NAME=
SCRAPER_LOCATION=

# Server
PORT=3001
NODE_ENV=production

# Optional
LOW_DISK_WARNING_GB=2
ACCENT_COLOR=#423A8E

# Set to true by the setup wizard — controls whether the wizard is shown on first run
SETUP_COMPLETE=
